# Disable directory listings.
Options -Indexes

# Default file.
DirectoryIndex index.php

# Block direct access to environment files and hidden files/directories
<FilesMatch "^\.env">
    Order allow,deny
    Deny from all
</FilesMatch>

# Error Documents
ErrorDocument 404 storefront/errors/404.php
ErrorDocument 500 storefront/errors/500.php

# -----------------------------------------------------------------
# 1. Rewrites: 301 Legacy Redirects & Clean Pretty URLs
# -----------------------------------------------------------------
<IfModule mod_rewrite.c>
    RewriteEngine On

    # 301 Legacy Redirects (Preserving Query Strings)
    RewriteRule ^shop\.php$ storefront/shop/index.php [R=301,L,QSA]
    RewriteRule ^category\.php$ storefront/shop/category.php [R=301,L,QSA]
    RewriteRule ^product\.php$ storefront/shop/product.php [R=301,L,QSA]
    RewriteRule ^cart\.php$ storefront/cart/index.php [R=301,L,QSA]
    RewriteRule ^checkout\.php$ storefront/cart/checkout.php [R=301,L,QSA]
    RewriteRule ^order_confirmation\.php$ storefront/cart/confirmation.php [R=301,L,QSA]
    RewriteRule ^track\.php$ storefront/track/index.php [R=301,L,QSA]
    RewriteRule ^login\.php$ storefront/auth/login.php [R=301,L,QSA]
    RewriteRule ^register\.php$ storefront/auth/register.php [R=301,L,QSA]
    RewriteRule ^logout\.php$ storefront/auth/logout.php [R=301,L,QSA]
    RewriteRule ^forgot_password\.php$ storefront/auth/forgot-password.php [R=301,L,QSA]
    RewriteRule ^reset_password\.php$ storefront/auth/reset-password.php [R=301,L,QSA]
    RewriteRule ^verify_email\.php$ storefront/auth/verify-email.php [R=301,L,QSA]
    RewriteRule ^resend_verification\.php$ storefront/auth/resend-verification.php [R=301,L,QSA]
    RewriteRule ^maintenance\.php$ storefront/errors/maintenance.php [R=301,L,QSA]
    RewriteRule ^404\.php$ storefront/errors/404.php [R=301,L,QSA]
    RewriteRule ^sitemap\.php$ storefront/seo/sitemap.php [R=301,L,QSA]

    # Clean Pretty URLs
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^shop/?$ storefront/shop/index.php [L,QSA]

    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^category/([^/]+)/?$ storefront/shop/category.php?slug=$1 [L,QSA]

    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^product/([^/]+)/?$ storefront/shop/product.php?slug=$1 [L,QSA]

    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^cart/?$ storefront/cart/index.php [L,QSA]

    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^checkout/?$ storefront/cart/checkout.php [L,QSA]

    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^order/confirmation/?$ storefront/cart/confirmation.php [L,QSA]

    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^track/?$ storefront/track/index.php [L,QSA]

    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^login/?$ storefront/auth/login.php [L,QSA]

    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^register/?$ storefront/auth/register.php [L,QSA]

    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^logout/?$ storefront/auth/logout.php [L,QSA]

    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^forgot-password/?$ storefront/auth/forgot-password.php [L,QSA]

    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^reset-password/?$ storefront/auth/reset-password.php [L,QSA]

    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^verify-email/?$ storefront/auth/verify-email.php [L,QSA]

    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^resend-verification/?$ storefront/auth/resend-verification.php [L,QSA]

    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^page/([^/]+)/?$ storefront/pages/view.php?slug=$1 [L,QSA]

    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^contact/?$ storefront/pages/contact.php [L,QSA]

    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^newsletter/?$ storefront/pages/newsletter.php [L,QSA]

    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^sitemap\.xml$ storefront/seo/sitemap.php [L]

    # Fallback rewrite for direct legacy folder paths (e.g. /shop/ -> /storefront/shop/)
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(shop|cart|auth|track|pages|errors|seo)(/.*)?$ storefront/$1$2 [L,QSA]
</IfModule>

# -----------------------------------------------------------------
# 2. Gzip / Deflate Compression (HTML, CSS, JS, JSON, SVG, Fonts)
# -----------------------------------------------------------------
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript
    AddOutputFilterByType DEFLATE application/javascript application/x-javascript application/json application/xml application/rss+xml
    AddOutputFilterByType DEFLATE image/svg+xml font/woff font/woff2
</IfModule>

# -----------------------------------------------------------------
# 3. Browser Caching / Expiration Rules (Assets vs Dynamic Pages)
# -----------------------------------------------------------------
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 month"
    ExpiresByType text/html "access plus 0 seconds"
    ExpiresByType application/json "access plus 0 seconds"
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType text/javascript "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"
</IfModule>

# -----------------------------------------------------------------
# 4. HTTP Header Directives (Cache-Control & Security Headers)
# -----------------------------------------------------------------
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    <FilesMatch "\.(css|js|woff2|woff|ttf|png|jpe?g|gif|svg|webp|ico)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    <FilesMatch "\.(php|html)$">
        Header set Cache-Control "private, no-cache, no-store, must-revalidate"
    </FilesMatch>
</IfModule>
