[Unit]
Description=Ecommerce Mail Queue Worker
After=network.target mysql.service
Wants=mysql.service

[Service]
Type=oneshot
User=www-data
Group=www-data
WorkingDirectory=/var/www/html/rust-backend
EnvironmentFile=/var/www/html/rust-backend/.env
ExecStart=/var/www/html/rust-backend/target/release/mail-worker --limit=50
StandardOutput=journal
StandardError=journal
SyslogIdentifier=ecommerce-mail-worker
