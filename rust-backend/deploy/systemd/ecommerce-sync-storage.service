[Unit]
Description=Ecommerce Storage Sync Worker
After=network.target mysql.service

[Service]
Type=oneshot
User=www-data
Group=www-data
WorkingDirectory=/var/www/html/rust-backend
EnvironmentFile=/var/www/html/rust-backend/.env
ExecStart=/var/www/html/rust-backend/target/release/sync-storage --limit=50
StandardOutput=journal
StandardError=journal
SyslogIdentifier=ecommerce-sync-storage
