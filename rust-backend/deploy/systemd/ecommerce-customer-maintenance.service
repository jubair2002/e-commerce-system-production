[Unit]
Description=Ecommerce Daily Customer Maintenance
After=network.target mysql.service

[Service]
Type=oneshot
User=www-data
Group=www-data
WorkingDirectory=/var/www/html/rust-backend
EnvironmentFile=/var/www/html/rust-backend/.env
ExecStart=/var/www/html/rust-backend/target/release/customer-maintenance
StandardOutput=journal
StandardError=journal
SyslogIdentifier=ecommerce-customer-maintenance
