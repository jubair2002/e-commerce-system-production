[Unit]
Description=Jinishpotro System Metrics Collector (Rust)
After=network.target mysql.service

[Service]
Type=oneshot
User=www-data
Group=www-data
WorkingDirectory=/var/www/html
EnvironmentFile=/var/www/html/.env
ExecStart=/var/www/html/rust-backend/target/release/collect_metrics
StandardOutput=journal
StandardError=journal
SyslogIdentifier=jinishpotro-metrics
