# Allow images, deny PHP execution.
<FilesMatch "(?i)\.(php[0-9]?|phtml|phar|phps|cgi|pl|py|sh)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# Fallback to uploads.php if requested media file is not physically on disk in assets/uploads/
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^(.+)$ ../../uploads.php?file=$1 [L,QSA]
</IfModule>
