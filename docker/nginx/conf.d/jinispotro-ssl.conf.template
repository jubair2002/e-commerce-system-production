# ==============================================================================
# Jinispotro Production Nginx SSL Configuration (HTTPS)
# Domain: jinishpotro.store (and www.jinishpotro.store)
# ==============================================================================

# 1. HTTP -> HTTPS Global Redirect (and ACME challenge for automated renewals)
server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name jinishpotro.store www.jinishpotro.store _;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# 2. Main E-Commerce Application (HTTPS)
server {
    listen 443 ssl http2 default_server;
    listen [::]:443 ssl http2 default_server;
    server_name jinishpotro.store www.jinishpotro.store;

    ssl_certificate /etc/letsencrypt/live/jinishpotro.store/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/jinishpotro.store/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers on;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 10m;

    client_max_body_size 64M;

    location / {
        proxy_pass http://app:80;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 300s;
        proxy_connect_timeout 60s;
        proxy_send_timeout 60s;
        proxy_buffer_size 128k;
        proxy_buffers 4 256k;
        proxy_busy_buffers_size 256k;
    }
}
