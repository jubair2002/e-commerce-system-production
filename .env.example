# ==============================================================================
# Jinispotro Production & Docker Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. AWS S3 Storage Settings (Fill these with your AWS S3 details)
# ------------------------------------------------------------------------------
# Primary storage provider: s3 (for production AWS S3) or local (for local disk)
STORAGE_PRIMARY=s3

# Fallback storage provider for high-availability: local (recommended) or none
# When primary S3 write fails or during network outages, upload falls back to local disk
# and is synced asynchronously to S3 by the background sync worker.
STORAGE_FALLBACK=local

# Your AWS Region (e.g. ap-southeast-1, us-east-1, eu-west-1)
AWS_REGION=ap-southeast-1

# Your AWS S3 Bucket Name
S3_BUCKET=your-production-bucket-name

# AWS IAM Credentials (leave empty on EC2 to automatically use IAM Instance Role)
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key

# Optional: CloudFront CDN distribution domain or public bucket base URL
# e.g., https://d123456789abcdef.cloudfront.net
S3_PUBLIC_BASE_URL=

# Prefix for all S3 keys (e.g. uploads/ or media/)
S3_KEY_PREFIX=uploads/

# Optional: S3 Compatible Endpoint (MinIO, Cloudflare R2, LocalStack)
# S3_ENDPOINT=http://127.0.0.1:9000
# S3_USE_PATH_STYLE_ENDPOINT=true

# ------------------------------------------------------------------------------
# 2. Database Connection (Pre-configured for Docker Compose)
# ------------------------------------------------------------------------------
# In Docker Compose, DB_HOST should remain 'db'. For external DB, set server IP/host.
DB_HOST=db
DB_PORT=3306
DB_NAME=php_admin_panel
DB_USER=jinispotro
DB_PASS=secret123
DB_ROOT_PASSWORD=rootsecret123
DB_CHARSET=utf8mb4

# ------------------------------------------------------------------------------
# 3. Application Security & URLs
# ------------------------------------------------------------------------------
APP_NAME="Jinispotro E-Commerce"
APP_ENV=production
# Generate a 64-character random key: php -r "echo bin2hex(random_bytes(32));"
APP_KEY=c84f1a29e46a78b901d3e5f72a6b8c9d0e1f2a3b4c5d6e7f8a9b0c1d2e3f4a5b
APP_TIMEZONE=Asia/Dhaka
BASE_URL=/
SITE_URL=http://localhost

# Optional: Port overrides for Docker host
APP_PORT=80
DB_PORT_HOST=3306
GRAFANA_PORT=3000
PROMETHEUS_PORT=9090

# ------------------------------------------------------------------------------
# 4. Monitoring & Grafana Settings
# ------------------------------------------------------------------------------
# Grafana Admin Credentials
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
# Target domain for Grafana reverse proxy (e.g. grafana.domain.com)
GRAFANA_DOMAIN=grafana.domain.com
GRAFANA_ANONYMOUS_ENABLED=true

# Optional: Bearer token for /metrics.php endpoint
METRICS_TOKEN=
