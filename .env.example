# Database Connection
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=php_admin_panel
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# Application
APP_NAME="PHP Admin Panel"
APP_ENV=development
# Generate a 64-char key with: php -r "echo bin2hex(random_bytes(32));"
APP_KEY=
APP_TIMEZONE=Asia/Dhaka

# URLs (Optional overrides. Leave empty to auto-detect from host/script path)
BASE_URL=
SITE_URL=

# Uploads storage (Optional: set if storing uploads on an external disk/volume outside the git repository)
# Leave empty/commented out to use the default repository folder: assets/uploads
# UPLOADS_PATH=/var/www/uploads
# UPLOADS_URL=/uploads/
